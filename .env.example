# Copie para .env e preencha. Nunca versione o .env.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# IDs de modelo conferidos em 2026-11-23 (aistudio.google.com/docs/models e openrouter.ai/models).
# Os nomes mudam com frequência: confira antes de usar e atualize precos.json junto.
EXTRACAO_PROVEDOR=anthropic         # anthropic | gemini | openrouter
EXTRACAO_MODELO=claude-opus-5-5     # mais baratos: claude-sonnet-5-5, claude-haiku-5-5 (avaliar qualidade antes)
# Esforço de raciocínio do Claude: low | medium | high | xhigh | max. low = mais barato.
ANTHROPIC_EFFORT=low
# Refaz em outro modelo se o Claude recusar por política de segurança (raro em certificados).
ANTHROPIC_FALLBACKS=true
VERIFICACAO_PROVEDOR=openrouter     # 2ª leitura dos campos críticos, de preferência outro modelo
VERIFICACAO_MODELO=mistralai/pixtral-large-2502
CONSULTA_PROVEDOR=                  # fase 3
CONSULTA_MODELO=
EMBEDDING_PROVEDOR=                 # fase 2
EMBEDDING_MODELO=

OPENROUTER_ZDR=true
# Engine de PDF no OpenRouter: native | mistral-ocr | cloudflare-ai.
# Só "native" fica dentro do ZDR. mistral-ocr passa o PDF pelo plugin (fora do ZDR, US$ 2 / 1000 páginas).
OPENROUTER_PDF_ENGINE=native

EXTRACAO_MODO_ENTRADA=auto          # pdf | imagens | auto (decidido pelo experimento; hoje auto = pdf, provisório)
VERIFICACAO_MODO_ENTRADA=recortes   # pdf | imagens | recortes (faixas ampliadas da página)

# Resolução das páginas de PDF/imagem no Gemini: low | medium | high
GEMINI_RESOLUCAO_PDF=high
DPI_IMAGENS=200
DPI_RECORTES=350
